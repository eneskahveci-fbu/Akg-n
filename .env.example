# Google Analytics (GA4) — isteğe bağlı.
# Ölçüm Kimliği: https://analytics.google.com üzerinden ücretsiz bir GA4
# mülkü oluşturup "G-XXXXXXXXXX" formatındaki Ölçüm Kimliği'ni buraya girin.
# Boş bırakılırsa analytics hiç yüklenmez.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sitenin canlı adresi. Sitemap/robots/OG etiketleri için kullanılır.
# Özel domain bağlarsanız burayı güncelleyin (örn. https://akgunomuzubozlu.com).
NEXT_PUBLIC_SITE_URL=https://akg-n.vercel.app
